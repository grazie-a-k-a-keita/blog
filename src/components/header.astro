---
import { Image } from "astro:assets";
import { ModeToggle } from "@/components/mode-toggle";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { appConfig } from "@/shared/app.config";
import GitHubIcon from "../asset/GitHub_light.svg";
import Logo from "../asset/logo.png";
import XIcon from "../asset/x.svg";
---

<header
	class="bg-accent/50 fixed top-8 left-1/2 z-50 w-fit -translate-x-1/2 rounded-full px-6 py-4 backdrop-blur"
>
	<nav aria-label="グローバル" class="flex items-center gap-4">
		<a
			href="/"
			aria-label="GrazieHub トップページ"
			class={cn(
				buttonVariants({
					size: "icon",
					variant: "ghost",
					className: "size-10",
				}),
				"rounded-full",
			)}
			><Image src={Logo} class="size-10 rounded-full" alt="" /></a
		>
		<a
			href="/blog"
			class={cn(buttonVariants({ variant: "ghost" }), "rounded-full")}
			>blog</a
		>
		<a
			aria-label="GitHub（新しいタブで開く）"
			href={appConfig.gitHubUrl}
			rel="noopener noreferrer"
			target="_blank"
			class={cn(
				buttonVariants({ variant: "ghost", size: "icon" }),
				"rounded-full",
			)}
		>
			<GitHubIcon
				aria-hidden="true"
				class="size-4 dark:invert"
				width={16}
				height={16}
			/>
		</a>
		<a
			aria-label="X（新しいタブで開く）"
			href={appConfig.xUrl}
			rel="noopener noreferrer"
			target="_blank"
			class={cn(
				buttonVariants({ variant: "ghost", size: "icon" }),
				"rounded-full",
			)}
		>
			<XIcon
				aria-hidden="true"
				class="size-4 dark:invert"
				width={16}
				height={16}
			/>
		</a>
		<ModeToggle client:load />
	</nav>
</header>
