---
import "../styles/global.css";
import type { CollectionEntry } from "astro:content";
import { appConfig } from "@/shared/app.config";
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";

type Props =
	| { title: string; description: string }
	| { article: CollectionEntry<"blog"> };

const props = Astro.props;
const { title, description, article } =
	"article" in props
		? {
				title: `${props.article.data.title} | ${appConfig.title}`,
				description: props.article.data.description,
				article: props.article,
			}
		: { ...props, article: undefined };

const url = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(
	article ? `/og/${article.id}.png` : appConfig.ogImage,
	Astro.site,
);
const ogImageAlt = article?.data.title ?? appConfig.title;
const ogType = article ? "article" : "website";
const publishedTime = article?.data.pubDate.toISOString();
const modifiedTime = article?.data.updatedDate?.toISOString();

const siteUrl = new URL("/", Astro.site).href;
const websiteId = `${siteUrl}#website`;
const authorId = `${siteUrl}#author`;
const jsonLd: Record<string, unknown>[] = [
	{
		"@type": "WebSite",
		"@id": websiteId,
		name: appConfig.title,
		description: appConfig.description,
		url: siteUrl,
		inLanguage: "ja",
		author: { "@id": authorId },
	},
	{
		"@type": "Person",
		"@id": authorId,
		name: appConfig.author.name,
		alternateName: appConfig.author.alternateName,
		url: siteUrl,
		sameAs: appConfig.author.sameAs,
	},
];
if (article) {
	jsonLd.push(
		{
			"@type": "BlogPosting",
			"@id": `${url.href}#article`,
			headline: article.data.title,
			description,
			url: url.href,
			mainEntityOfPage: url.href,
			image: ogImage.href,
			datePublished: publishedTime,
			dateModified: modifiedTime ?? publishedTime,
			inLanguage: "ja",
			author: { "@id": authorId },
			publisher: { "@id": authorId },
			isPartOf: { "@id": websiteId },
		},
		{
			"@type": "BreadcrumbList",
			itemListElement: [
				{
					"@type": "ListItem",
					position: 1,
					name: appConfig.title,
					item: siteUrl,
				},
				{
					"@type": "ListItem",
					position: 2,
					name: "blog",
					item: new URL("/blog/", Astro.site).href,
				},
				{ "@type": "ListItem", position: 3, name: article.data.title },
			],
		},
	);
}
// </script> などで構造化データが閉じられないよう < をエスケープする
const jsonLdHtml = JSON.stringify({
	"@context": "https://schema.org",
	"@graph": jsonLd,
}).replace(/</g, "\\u003c");
---

<html lang="ja" class="scroll-smooth">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="description" content={description}>
		<link rel="canonical" href={url}>
		<meta property="og:type" content={ogType}>
		<meta property="og:site_name" content={appConfig.title}>
		<meta property="og:locale" content="ja_JP">
		<meta property="og:url" content={url}>
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		<meta property="og:image" content={ogImage}>
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
		<meta property="og:image:alt" content={ogImageAlt}>
		{publishedTime && (
			<meta property="article:published_time" content={publishedTime} />
		)}
		{modifiedTime && (
			<meta property="article:modified_time" content={modifiedTime} />
		)}
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:site" content={appConfig.xHandle}>
		<meta name="twitter:creator" content={appConfig.xHandle}>
		<meta name="twitter:title" content={title}>
		<meta name="twitter:description" content={description}>
		<meta name="twitter:image" content={ogImage}>
		<meta name="twitter:image:alt" content={ogImageAlt}>
		<link rel="icon" href="/favicon.ico">
		<link
			rel="alternate"
			type="application/rss+xml"
			title={appConfig.title}
			href="/rss.xml"
		>
		<script type="application/ld+json" set:html={jsonLdHtml} />
		<title>{title}</title>
		<!-- mode toggle -->
		<script is:inline>
		const getThemePreference = () => {
			if (
				typeof localStorage !== "undefined" &&
				localStorage.getItem("theme")
			) {
				return localStorage.getItem("theme");
			}

			return window.matchMedia("(prefers-color-scheme: dark)").matches
				? "dark"
				: "light";
		};
		const isDark = getThemePreference() === "dark";
		document.documentElement.classList[isDark ? "add" : "remove"]("dark");

		if (typeof localStorage !== "undefined") {
			const observer = new MutationObserver(() => {
				const isDark = document.documentElement.classList.contains("dark");
				localStorage.setItem("theme", isDark ? "dark" : "light");
			});
			observer.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ["class"],
			});
		}
		</script>
	</head>
	<body
		class="container mx-auto min-h-dvh max-w-4xl overflow-y-scroll px-6 lg:px-8 pt-40 font-sans"
	>
		<Header />
		<main><slot /></main>
		<Footer />
	</body>
</html>
