---
import "../../styles/global.css";
import { formatDate } from "@/lib/date";
import { getSortedPosts, postUrl } from "@/lib/posts";
import { appConfig } from "@/shared/app.config";
import Layout from "../../layouts/main.astro";

const posts = await getSortedPosts();
const description = "勉強したことや日々思ったことを不定期で更新していきます。";
---

<Layout title={`blog | ${appConfig.title}`} description={description}>
	<section class="space-y-8">
		<h1 class="text-xl font-bold">blog</h1>
		<p>{description}</p>
		<ul class="list-outside list-disc space-y-3">
			{posts.map((post) => (
				<li class="ms-6">
					<article>
						<h2 class="inline font-normal">
							<a
								href={postUrl(post)}
								class="text-foreground/50 hover:text-foreground transition-colors hover:underline hover:bg-primary/10 decoration-primary underline-offset-4"
							>
								{post.data.title}
							</a>
						</h2>
						<time
							datetime={formatDate(post.data.pubDate)}
							class="text-foreground/50 font-mono"
						>
							（{formatDate(post.data.pubDate)}）
						</time>
					</article>
				</li>
			))}
		</ul>
	</section>
</Layout>
