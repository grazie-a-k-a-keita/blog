---
import { render } from "astro:content";
import { Calendar, RefreshCcw } from "lucide-react";
import { getPostStaticPaths, type Post } from "@/lib/posts";
import PostDate from "../../components/post-date.astro";
import Prose from "../../components/prose.astro";
import Toc from "../../components/toc";
import Layout from "../../layouts/main.astro";

export const getStaticPaths = getPostStaticPaths;

type Props = Post;

const post = Astro.props;
const { Content, headings } = await render(post);
---

<Layout article={post}>
	<article class="space-y-16">
		<header class="space-y-8 text-center">
			<h1 class="text-2xl font-bold">{post.data.title}</h1>
			<div
				class="text-muted-foreground flex flex-wrap items-center justify-center gap-6 font-mono"
			>
				<PostDate date={post.data.pubDate} label="公開日" icon={Calendar} />
				{post.data.updatedDate !== undefined && (
					<PostDate
						date={post.data.updatedDate}
						label="更新日"
						icon={RefreshCcw}
					/>
				)}
			</div>
		</header>
		<Prose>
			<Toc headings={headings} />
			<hr>
			<Content />
		</Prose>
	</article>
</Layout>
