---
import { type CollectionEntry, getCollection, render } from "astro:content";
import dayjs from "dayjs";
import { Calendar, RefreshCcw } from "lucide-react";
import { appConfig } from "@/shared/app.config";
import Prose from "../../components/prose.astro";
import Toc from "../../components/toc";
import Layout from "../../layouts/main.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content, headings } = await render(post);
---

<Layout
	content={{
		title: `${post.data.title} | ${appConfig.title}`,
		description: post.data.description,
		type: "article",
		publishedTime: post.data.pubDate.toISOString(),
		modifiedTime: post.data.updatedDate?.toISOString(),
	}}
>
	<article class="space-y-16">
		<header class="space-y-8 text-center">
			<h1 class="text-2xl font-bold">{post.data.title}</h1>
			<div
				class="text-muted-foreground flex flex-wrap items-center justify-center gap-6 font-mono"
			>
				<p class="flex items-center gap-2">
					<Calendar className="size-4" aria-hidden="true" />
					<span class="sr-only">公開日</span>
					<time datetime={post.data.pubDate.toISOString()}>
						{dayjs(post.data.pubDate).format("YYYY-MM-DD")}
					</time>
				</p>
				{post.data.updatedDate !== undefined && (
					<p class="flex items-center gap-2">
						<RefreshCcw className="size-4" aria-hidden="true" />
						<span class="sr-only">更新日</span>
						<time datetime={post.data.updatedDate.toISOString()}>
							{dayjs(post.data.updatedDate).format("YYYY-MM-DD")}
						</time>
					</p>
				)}
			</div>
		</header>
		<Prose>
			<Toc headings={headings} />
			<hr>
			<Content />
		</Prose>
	</article>
</Layout>
